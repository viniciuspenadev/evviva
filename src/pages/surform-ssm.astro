---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { images } from '../data/images';
import { surform, surformPosts } from '../data/surform';
const instagram = surform.instagram;
const questions = [
  { question: 'SSM é o mesmo que mármore ou quartzo?', answer: 'Não. Superfície Sólida Mineral é uma categoria de materiais compostos por resinas e cargas minerais. Existem diferentes formulações; composição, acabamento e desempenho devem ser avaliados no produto especificado.' },
  { question: 'É possível integrar a cuba à bancada?', answer: 'Esse é um dos caminhos explorados em superfícies sólidas: desenhar encontros entre cuba e tampo com uma leitura contínua. Formato, junções, espessuras e execução dependem do material e do projeto.' },
  { question: 'Quais cuidados fazem parte da rotina?', answer: 'Siga o manual do fabricante escolhido. Em Corian®, por exemplo, é preciso usar apoio para panelas quentes e tábua para cortar alimentos. A superfície pode riscar e não deve ser exposta indiscriminadamente a calor ou produtos químicos.' },
  { question: 'Como escolher o material para o meu ambiente?', answer: 'Comece pela aplicação, pela rotina de uso e pelo resultado visual desejado. Converse com a SURFORM sobre possibilidades, amostras, especificações e condições de execução antes de definir o projeto.' },
];
---
<Layout brand="surform" title="SURFORM — Superfícies em SSM" description="Conheça a SURFORM: superfícies sólidas minerais, possibilidades para cozinhas e lavabos e aplicações publicadas pela empresa." invitation={false}>
  <section class="surform-intro container">
    <a class="breadcrumb" href="/#ambientes">Universo Evviva <span>/</span> SURFORM</a>
    <div class="surform-heading"><div><p class="eyebrow">Superfícies sólidas minerais · SURFORM</p><h1>Superfícies contínuas.<br /><em>Possibilidades sob medida.</em></h1></div><div class="surform-intro-copy"><p>A forma, o toque, o encontro entre materiais. Uma nova leitura para bancadas, cubas e os detalhes que fazem parte da sua rotina.</p><a class="text-link" href="#publicacoes">Ver a SURFORM na prática <Arrow /></a></div></div>
  </section>
  <section class="surform-visual" aria-label="Referência de aplicação em cozinha"><Image src={images.surformKitchen} widths={[480, 800, 1200, 1600]} sizes="100vw" format="webp" quality={90} alt="Cozinha com bancada branca em superfície sólida, cuba integrada e armários em madeira." loading="eager" fetchpriority="high" /><div class="surform-visual-caption"><span>Matéria & forma / Cozinhas</span></div></section>
  <section class="section container surform-about" id="sobre"><div><p class="eyebrow">A matéria por trás da forma</p><h2>Um novo olhar<br /><em>para as superfícies.</em></h2></div><div><p>A SURFORM apresenta aplicações de superfícies sólidas em cozinhas e lavabos. Bancadas, cubas e acessórios entram em diálogo com o desenho do ambiente e com a vida que acontece nele.</p><p>SSM significa <strong>Superfície Sólida Mineral</strong>: uma família de materiais que combina resinas e cargas minerais. As formulações variam, e cada escolha pede uma especificação adequada ao ambiente.</p><a class="text-link" href="#publicacoes">Conhecer as aplicações publicadas <Arrow /></a></div></section>
  <section class="surform-detail section" id="aplicacoes"><div class="container surform-detail-grid"><div class="surform-detail-image"><Image src={images.surformBasin} widths={[400, 700, 1000]} sizes="(max-width: 800px) 100vw, 48vw" format="webp" quality={88} alt="Lavabo com cuba integrada ao tampo branco e gabinete em madeira." loading="lazy" /><span>Matéria & forma / Lavabos</span></div><div class="surform-detail-copy"><p class="eyebrow">O desenho mora no encontro</p><h2>Quando o detalhe<br /><em>faz parte do todo.</em></h2><p>Da bancada de cozinha ao lavabo, a superfície participa da experiência de usar e sentir o ambiente.</p><dl class="surform-possibilities"><div><dt><span>01</span> Continuidade visual</dt><dd>Junções e encontros podem ser trabalhados para uma leitura integrada, conforme o material e a execução.</dd></div><div><dt><span>02</span> Cuba e tampo em diálogo</dt><dd>Uma possibilidade para explorar o desenho conjunto da bancada e da cuba.</dd></div><div><dt><span>03</span> Composição com a arquitetura</dt><dd>A superfície clara encontra a madeira, a luz e as proporções do espaço.</dd></div></dl><p class="surform-small-note">Cores, formas e viabilidade são definidas com a SURFORM para cada projeto.</p></div></div></section>
  <section class="surform-publications section" id="publicacoes" aria-labelledby="surform-publications-title"><div class="container"><div class="surform-publications-heading"><div><p class="eyebrow">Do perfil oficial · @surform_ssm</p><h2 id="surform-publications-title">Veja a matéria<br /><em>ganhar forma.</em></h2></div><div><p>Aplicações e detalhes apresentados pela própria SURFORM. Uma seleção para conhecer a linguagem da empresa em cozinhas e lavabos.</p><a class="text-link" href={instagram} target="_blank" rel="noopener noreferrer">Explorar o perfil completo <Arrow /></a></div></div><div class="surform-post-grid">{surformPosts.map(post => <article class="surform-post"><div class="surform-post-meta"><span>SURFORM / Instagram</span><time datetime={post.datetime}>{post.date}</time></div><div class="surform-post-media"><iframe src={`https://www.instagram.com/p/${post.code}/embed/`} title={`Publicação da SURFORM: ${post.title}`} loading="lazy" allow="fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe></div><div class="surform-post-copy"><p class="eyebrow">{post.category}</p><h3>{post.title}</h3><p>{post.description}</p><a class="text-link" href={`https://www.instagram.com/surform_ssm/reel/${post.code}/`} target="_blank" rel="noopener noreferrer">Ver publicação original <Arrow /></a></div></article>)}</div><p class="surform-publications-note">Publicações do perfil SURFORM, com autoria e datas indicadas. Se algum vídeo não carregar, use o link para abrir a publicação no Instagram.</p></div></section>
  <section class="section container surform-choices"><div class="surform-choices-heading"><p class="eyebrow">Da inspiração à escolha</p><h2>O seu espaço.<br /><em>O começo do desenho.</em></h2><p>Três pontos para levar à conversa sobre o seu projeto.</p></div><ol><li><span>01 / O espaço</span><h3>Como você vive?</h3><p>Comece pelo ambiente, pela rotina e pelo que a bancada precisa resolver no dia a dia.</p></li><li><span>02 / A matéria</span><h3>O que você sente?</h3><p>Compare amostras, cores, acabamentos e a documentação do produto proposto.</p></li><li><span>03 / O conjunto</span><h3>Como tudo se encontra?</h3><p>Converse sobre cubas, bordas, junções e as condições de execução e instalação.</p></li></ol></section>
  <section class="section container surform-questions" id="duvidas"><div><p class="eyebrow">Para escolher com clareza</p><h2>Beleza na forma.<br /><em>Cuidado no uso.</em></h2><p>Conhecer o material também faz parte de criar um ambiente que acompanha a sua rotina.</p></div><div class="surform-faq">{questions.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}<p class="surform-sources">Sobre o material: <a href="https://www.durasein.com.br/post/superficie-solida-mineral" target="_blank" rel="noopener noreferrer">SSM, por Durasein ↗</a> · <a href="https://www.corian.com/-use-care" target="_blank" rel="noopener noreferrer">Cuidados com Corian® ↗</a>. As orientações dependem do produto escolhido.</p></div></section>
  <section class="surform-invitation"><div class="container"><p class="eyebrow">SURFORM · Matéria para novas ideias</p><h2>Que forma o seu<br /><em>próximo espaço pode ter?</em></h2><a class="button button-ivory" href={instagram} target="_blank" rel="noopener noreferrer">Explorar o universo SURFORM <Arrow /></a><a class="surform-back" href="/#ambientes">Voltar aos ambientes <Arrow /></a></div></section>
</Layout>
<style>
  .surform-intro { padding-block: 36px 60px; }
  .surform-intro .breadcrumb { margin-bottom: 46px; }
  .surform-heading { display: grid; grid-template-columns: 1.6fr 1fr; align-items: end; gap: 6vw; }
  .surform-heading h1 { font-size: clamp(44px, 5vw, 76px); line-height: 1.13; }
  .surform-intro-copy > p { color: var(--muted); font-size: 15px; }
  .surform-intro-copy .text-link { font-size: 11px; gap: 20px; margin-top: 22px; }
  .surform-visual { position: relative; }
  .surform-visual > img { width: 100%; height: clamp(430px, 48vw, 740px); object-fit: cover; }
  .surform-visual-caption { position: absolute; inset-inline: 0; bottom: 0; display: flex; justify-content: space-between; padding: 50px var(--gutter) 24px; background: linear-gradient(transparent, rgb(25 25 28 / .65)); color: white; font-size: 9px; letter-spacing: .1em; text-transform: uppercase; }
  .surform-about { display: grid; grid-template-columns: 1.15fr 1fr; gap: 9vw; }
  .surform-about h2 { font-size: clamp(36px, 3.8vw, 58px); }
  .surform-about > div > p:not(.eyebrow) { font-size: 15px; color: var(--muted); margin-bottom: 22px; }
  .surform-about strong { font-weight: 500; color: var(--ink); }
  .surform-about .text-link { font-size: 12px; }
  .surform-detail { background: var(--taupe); }
  .surform-detail-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 7vw; align-items: center; }
  .surform-detail-image { position: relative; }
  .surform-detail-image > img { width: 100%; height: 660px; object-fit: cover; }
  .surform-detail-image > span { position: absolute; bottom: 18px; left: 18px; background: rgb(36 36 38 / .8); color: white; padding: 8px 12px; font-size: 9px; }
  .surform-detail-copy h2 { font-size: clamp(36px, 3.8vw, 56px); }
  .surform-detail-copy > p:not(.eyebrow) { font-size: 14px; color: var(--muted); margin-top: 25px; }
  .surform-possibilities { margin: 26px 0 0; }
  .surform-possibilities > div { padding-block: 20px; border-top: 1px solid #c3bcae; }
  .surform-possibilities dt { font-size: 13px; display: flex; gap: 18px; }
  .surform-possibilities dt > span { font-size: 10px; color: var(--bronze); padding-top: 2px; }
  .surform-possibilities dd { margin: 10px 0 0 32px; font-size: 12px; line-height: 1.8; color: var(--muted); }
  .surform-detail-copy > .surform-small-note { font-size: 10px !important; line-height: 1.7; margin-top: 12px !important; }
  .surform-questions { display: grid; grid-template-columns: 1fr 1.1fr; gap: 8vw; }
  .surform-questions h2 { font-size: clamp(36px, 3.7vw, 56px); }
  .surform-questions > div > p:not(.eyebrow) { font-size: 14px; max-width: 360px; color: var(--muted); margin-top: 25px; }
  .surform-faq details { border-top: 1px solid var(--line); }
  .surform-faq details:last-of-type { border-bottom: 1px solid var(--line); }
  .surform-faq summary { display: flex; justify-content: space-between; gap: 20px; align-items: center; list-style: none; cursor: pointer; min-height: 80px; padding: 20px 0; font-size: 14px; }
  .surform-faq summary::-webkit-details-marker { display: none; }
  .surform-faq summary span { font-size: 24px; font-weight: 400; transition: transform .25s; }
  .surform-faq details[open] summary span { transform: rotate(45deg); }
  .surform-faq details p { font-size: 13px; color: var(--muted); padding-bottom: 24px; }
  .surform-questions .surform-faq > .surform-sources { font-size: 10px; max-width: none; line-height: 1.8; }
  .surform-sources a { text-decoration: underline; text-underline-offset: 3px; }
  .surform-invitation { background: var(--charcoal); color: var(--ivory); text-align: center; padding-block: 85px; }
  .surform-invitation h2 { font-size: clamp(38px, 4.5vw, 68px); }
  .surform-invitation .button { margin-top: 34px; }
  .surform-back { display: flex; width: fit-content; align-items: center; justify-content: center; gap: 15px; margin: 24px auto 0; font-size: 11px; color: #d0cbbb; }
  .surform-back .arrow-icon { transform: rotate(180deg); width: 17px; }
  .surform-publications { background: #e9e4da; }
  .surform-publications-heading { display: grid; grid-template-columns: 1.1fr 1fr; gap: 9vw; align-items: end; margin-bottom: 48px; }
  .surform-publications-heading h2 { font-size: clamp(38px, 4.2vw, 64px); }
  .surform-publications-heading > div > p:not(.eyebrow) { font-size: 14px; color: var(--muted); max-width: 430px; }
  .surform-publications-heading .text-link { margin-top: 16px; font-size: 12px; }
  .surform-post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 28px; }
  .surform-post { min-width: 0; border-top: 1px solid #bdb5a6; }
  .surform-post-meta { display: flex; justify-content: space-between; gap: 10px; align-items: center; padding-block: 16px; font-size: 8px; color: var(--muted); }
  .surform-post-meta > span { text-transform: uppercase; letter-spacing: .08em; }
  .surform-post-media { container-type: inline-size; background: var(--paper); border: 1px solid #d6d0c5; border-radius: 14px; overflow: hidden; }
  .surform-post-media iframe { display: block; width: 100%; height: calc(125cqw + 220px); border: 0; }
  .surform-post-copy { padding-top: 23px; }
  .surform-post-copy .eyebrow { font-size: 8px; letter-spacing: .13em; }
  .surform-post-copy h3 { margin-top: 12px; font-size: 29px; }
  .surform-post-copy > p:not(.eyebrow) { margin-top: 15px; color: var(--muted); font-size: 12px; }
  .surform-post-copy .text-link { font-size: 11px; margin-top: 17px; }
  .surform-publications-note { margin-top: 32px; color: var(--muted); font-size: 10px; line-height: 1.7; }
  .surform-choices { border-bottom: 1px solid var(--line); }
  .surform-choices-heading { max-width: 700px; }
  .surform-choices-heading > p:last-child { font-size: 14px; color: var(--muted); margin-top: 25px; }
  .surform-choices ol { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 45px; padding: 0; margin: 45px 0 0; }
  .surform-choices li { border-top: 1px solid var(--line); padding-top: 18px; }
  .surform-choices li > span { font-size: 9px; text-transform: uppercase; letter-spacing: .13em; color: var(--bronze); }
  .surform-choices h3 { font-size: 29px; margin-top: 23px; }
  .surform-choices li > p { color: var(--muted); font-size: 12px; margin-top: 15px; }
  @media(max-width: 1000px) { .surform-post-grid { gap: 20px; } .surform-post-copy h3 { font-size: 25px; } .surform-post-meta { flex-direction: column; align-items: start; gap: 6px; } }
  @media(max-width: 800px) { .surform-publications-heading { grid-template-columns: 1fr; gap: 25px; } .surform-post-grid { grid-template-columns: 1fr; gap: 40px; } .surform-post { max-width: 540px; width: 100%; margin-inline: auto; } .surform-post-meta { flex-direction: row; } .surform-choices ol { grid-template-columns: 1fr; gap: 32px; } }
  @media(max-width: 600px) { .surform-publications-heading h2 { font-size: 38px; } .surform-publications-heading > div > p:not(.eyebrow) { font-size: 13px; } .surform-post-copy h3 { font-size: 29px; } .surform-choices-heading h2 { font-size: 37px; } }
  @media(max-width: 1000px) { .surform-heading { grid-template-columns: 1fr; gap: 28px; } .surform-intro-copy { max-width: 520px; } .surform-detail-image > img { height: 680px; } }
  @media(max-width: 800px) { .surform-about, .surform-detail-grid, .surform-questions { grid-template-columns: 1fr; gap: 35px; } .surform-detail-image > img { height: 540px; } .surform-detail-copy { max-width: 600px; } .surform-questions > div > p:not(.eyebrow) { max-width: 500px; } }
  @media(max-width: 600px) { .surform-intro { padding-block: 28px 38px; } .surform-intro .breadcrumb { margin-bottom: 32px; font-size: 10px; } .surform-heading h1 { font-size: clamp(33px, 8.5vw, 48px); } .surform-intro-copy > p { font-size: 13px; } .surform-intro-copy .text-link { font-size: 10px; gap: 14px; } .surform-visual > img { height: 430px; object-position: 61% center; } .surform-visual-caption { font-size: 7px; gap: 15px; padding-bottom: 18px; } .surform-about h2, .surform-detail-copy h2, .surform-questions h2 { font-size: 36px; } .surform-about > div > p:not(.eyebrow) { font-size: 13px; } .surform-about .text-link { font-size: 10px; gap: 18px; } .surform-detail-image > img { height: 420px; } .surform-detail-copy > p:not(.eyebrow) { font-size: 13px; } .surform-faq summary { font-size: 13px; } .surform-faq details p { font-size: 12px; } .surform-invitation { padding-block: 64px; } .surform-invitation h2 { font-size: 36px; } .surform-invitation .button { font-size: 11px; padding-inline: 18px; gap: 16px; } }
</style>
