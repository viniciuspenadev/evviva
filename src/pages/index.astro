---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import EnvironmentGallery from '../components/EnvironmentGallery.astro';
import ServiceCategories from '../components/ServiceCategories.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import FamilyScene from '../components/FamilyScene.astro';
import CollectionWheel from '../components/CollectionWheel.astro';
import { process } from '../data/content';
import { images } from '../data/images';
---
<Layout>
  <section class="hero" aria-labelledby="hero-title">
    <Image class="hero-image" src={images.kitchen} widths={[640, 960, 1440, 1672]} sizes="100vw" format="webp" quality={90} alt="Cozinha de madeira com ilha em pedra clara integrada a um living iluminado." loading="eager" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="container hero-content"><p class="eyebrow">Mobiliário personalizado</p><h1 id="hero-title">A casa, à sua<br />maneira.</h1><p class="hero-description">Design que acolhe.<br class="mobile-only" /> Detalhes que revelam você.</p><a class="button button-ivory" href="#projetos">Conhecer serviços <Arrow /></a></div>
    <div class="hero-bottom"><a href="#projetos" aria-label="Descer para os serviços"><Arrow direction="down" /></a><span>Matéria · Forma · Identidade</span></div>
  </section>

  <ServiceCategories />
  <EnvironmentGallery />
  <PortfolioPreview />

  <section class="philosophy family-philosophy section" id="jeito-de-viver" aria-labelledby="philosophy-title"><div class="container philosophy-grid"><FamilyScene /><div class="philosophy-copy"><p class="eyebrow">Muito além das medidas</p><h2 id="philosophy-title">O seu jeito de viver<br />é o ponto de partida.</h2><p>A casa guarda o que somos. Os encontros, os pequenos rituais, as escolhas que fazemos todos os dias.</p><p>Na Evviva, a personalização abre espaço para essas particularidades. Mobiliário pensado em diálogo com a arquitetura e com a vida que acontece nela.</p><a class="text-link" href="/nossa-loja/">Conheça essa experiência <Arrow /></a></div></div></section>

  <CollectionWheel />

  <section class="section material-preview" aria-labelledby="materials-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">A beleza mora no detalhe</p><h2 id="materials-title">Matéria que desperta<br /><em>novos sentidos.</em></h2></div><div class="section-aside"><p>Texturas, cores e sensações.<br />O começo de uma escolha pessoal.</p><a class="text-link" href="/materiais/">Explorar materiais <Arrow /></a></div></div><a class="material-composition" href="/materiais/" aria-label="Conhecer materiais e acabamentos"><div class="material-sample sample-wood"><span>01 / Madeira</span></div><div class="material-sample sample-stone"><span>02 / Superfícies</span></div><div class="material-sample sample-glass"><span>03 / Vidro</span><Arrow /></div></a><p class="image-disclaimer">Acabamentos e disponibilidade são definidos no projeto.</p></div></section>

  <section class="section process-section" aria-labelledby="process-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">Do primeiro encontro à sua casa</p><h2 id="process-title">Um projeto construído<br />com você.</h2></div><a class="text-link" href="/nossa-loja/">Como a conversa começa <Arrow /></a></div><ol class="process-grid">{process.map((item, index) => <li><span class="process-number">0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></li>)}</ol></div></section>

  <section class="architect-strip"><div class="container"><p class="eyebrow">Para arquitetos e designers</p><h2>Seu olhar.<br class="mobile-only" /> Novas possibilidades.</h2><a class="text-link" href="/arquitetos/">Vamos criar juntos <Arrow /></a></div></section>
</Layout>
