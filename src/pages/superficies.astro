---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { surfaceImages } from '../data/surform-media';
import { services } from '../data/services';
const questions = [
 {question:'O que é superfície sólida mineral?',answer:'SSM é uma família de materiais composta por resinas e cargas minerais. Existem diferentes formulações, e a composição do produto escolhido orienta sua aplicação, seu acabamento e seus cuidados.'},
 {question:'É possível integrar a cuba à bancada?',answer:'Cuba e bancada podem ser trabalhadas para uma leitura visual contínua. Desenho, junções, profundidades e viabilidade são avaliados conforme o produto e as condições do projeto.'},
 {question:'Superfície sólida existe somente em branco?',answer:'Existem diferentes cores e padrões, conforme o fabricante e a linha do produto: tons claros, areia, cinzas e cores escuras, entre outras possibilidades. A seleção para o seu projeto considera a disponibilidade da linha, a amostra física e os cuidados indicados para o uso.'},
 {question:'Quais cuidados fazem parte do uso?',answer:'Siga o manual do fabricante especificado. Use proteção para objetos quentes e uma tábua para cortar alimentos. Produtos de limpeza, manutenção e eventuais reparos devem ser compatíveis com a superfície escolhida.'},
 {question:'Como começar a especificação?',answer:'Traga medidas, uma planta ou referências do ambiente. A conversa passa pelo uso da bancada, pelo desenho das cubas, pelos encontros com a base e pela escolha do produto.'},
];
---
<Layout title="Superfícies sólidas — SURFORM" description="Entenda a superfície sólida mineral, as possibilidades de desenho de bancadas e cubas e os cuidados que fazem parte da especificação.">
  <section class="ssm-page-heading container"><p class="eyebrow">Superfície sólida mineral</p><h1>Liberdade no desenho.<br /><em>Intenção no detalhe.</em></h1><p>A forma, o toque e o encontro entre os elementos. Um material pensado em diálogo com a arquitetura e com o uso do espaço.</p></section>
  <Image class="ssm-wide-image" src={surfaceImages.detail} widths={[640,960,1200,1536]} sizes="100vw" format="webp" quality={92} alt="Acabamento acetinado e desenho interno de uma cuba integrada a uma superfície sólida." loading="eager" />
  <section class="section container ssm-editorial-grid"><div><p class="eyebrow">A matéria</p><h2>O começo de<br /><em>uma possibilidade.</em></h2></div><div><p><strong>Superfície sólida mineral</strong> é o nome de uma família de materiais que combina resinas e cargas minerais. Suas formulações variam: conhecer o produto faz parte de especificar bem.</p><p>Desenhar com superfícies sólidas significa pensar em conjunto a bancada, a cuba, as bordas e seus encontros. Cada aplicação pede uma escolha compatível com o espaço e com a rotina.</p><a class="text-link" href="/#aplicacoes">Explore as aplicações <Arrow /></a></div></section>
  <section class="surface-solutions section" aria-labelledby="solutions-heading"><div class="container"><div class="section-heading"><div><p class="eyebrow">O desenho em cada escala</p><h2 id="solutions-heading">Da superfície<br /><em>ao último encontro.</em></h2></div><p>Escolhas que aproximam<br />a matéria da sua rotina.</p></div><div class="surface-solution-list">{services.map(service => <article class="surface-solution" id={service.id}><div class="surface-solution-photo"><Image src={service.slides[0].image} widths={[480,800,1200]} sizes="(max-width:800px) 90vw, 45vw" format="webp" quality={92} alt={service.slides[0].alt} style={`object-position:${service.slides[0].position}`} loading="lazy" /></div><div class="surface-solution-copy"><p class="eyebrow">{service.label}</p><h3>{service.title}</h3><p>{service.introduction}</p><ul class="ssm-spec-list">{service.points.map(point => <li>{point}</li>)}</ul></div></article>)}</div><a class="text-link surface-solutions-cta" href="/contato/#preparar">Preparar meu projeto <Arrow /></a></div></section>
  <section class="section ssm-care"><div class="container ssm-care-grid"><div class="ssm-care-intro"><p class="eyebrow">Escolher com clareza</p><h2>Beleza na forma.<br /><em>Cuidado no uso.</em></h2></div><div>{questions.map(item => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}<p class="ssm-technical-source">Referências sobre a categoria e cuidados: <a href="https://www.durasein.com.br/post/superficie-solida-mineral" target="_blank" rel="noopener noreferrer">Durasein ↗</a> · <a href="https://www.corian.com/-use-care" target="_blank" rel="noopener noreferrer">Corian® ↗</a>. A orientação de uso é a do produto especificado.</p></div></div></section>
</Layout>
