---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import SurformPublications from '../components/SurformPublications.astro';
import { surfaceGallery, applications } from '../data/surform-media';
const photos = await Promise.all(surfaceGallery.map(async item => ({...item,full:await getImage({src:item.image,width:Math.min(item.image.width,1800),format:'webp',quality:92})})));
const filters = [{id:'todos',name:'Todas'},...applications.map(({id,name}) => ({id,name})),{id:'detalhes',name:'Detalhes'}];
---
<Layout title="Galeria de aplicações — SURFORM" description="Superfícies sólidas para cozinhas, lavabos, banhos, áreas gourmet, lavanderias, espaços comerciais e clínicas. Explore os desenhos e detalhes.">
  <section class="container ssm-page-heading ssm-gallery-heading"><div><p class="eyebrow">Galeria de aplicações</p><h1>Uma matéria.<br /><em>Diferentes espaços.</em></h1></div><div><p>Bancadas, cubas e os detalhes que conectam o conjunto. Uma seleção de possibilidades para começar a sua ideia.</p><a class="text-link" href="#publicacoes">Ver publicações da SURFORM <Arrow /></a></div></section>
  <section aria-label="Galeria de superfícies sólidas" data-surface-gallery>
    <div class="ssm-gallery-tools"><div class="container" role="group" aria-label="Filtrar por aplicação">{filters.map(item => <button type="button" id={item.id} data-surface-filter={item.id} aria-pressed={item.id === 'todos' ? 'true':'false'}>{item.name}</button>)}</div></div>
    <p class="ssm-sr-only" role="status" aria-live="polite" data-surface-status>{surfaceGallery.length} imagens de aplicações.</p>
    <div class="container ssm-gallery-grid">{photos.map(item => <figure data-surface-item data-category={item.category}><a href={item.full.src} data-surface-open data-title={item.title} data-alt={item.alt} aria-label={`Ampliar: ${item.title}`} aria-haspopup="dialog"><Image src={item.image} widths={[480,800,1200]} sizes="(max-width:600px) 90vw, 44vw" format="webp" quality={90} alt={item.alt} loading="lazy" /><span class="ssm-gallery-plus" aria-hidden="true">+</span></a><figcaption><p>{item.categoryTitle}</p><h2>{item.title}</h2></figcaption></figure>)}</div>
    <dialog class="ssm-lightbox" aria-label="Imagem ampliada da galeria SURFORM" data-surface-dialog><div class="ssm-lightbox-head"><span data-surface-counter></span><button class="icon-button" type="button" aria-label="Fechar imagem ampliada" data-surface-close>×</button></div><div class="ssm-lightbox-stage"><button class="ssm-lightbox-arrow" type="button" aria-label="Imagem anterior" data-surface-prev><Arrow /></button><img src={photos[0].full.src} alt={photos[0].alt} width={photos[0].full.attributes.width} height={photos[0].full.attributes.height} loading="lazy" decoding="async" data-surface-image /><button class="ssm-lightbox-arrow" type="button" aria-label="Próxima imagem" data-surface-next><Arrow /></button></div><div class="ssm-lightbox-caption"><h2 data-surface-title></h2><a href="/privacidade/#imagens">Sobre as imagens</a></div></dialog>
  </section>
  <SurformPublications />
</Layout>
<script>import '../scripts/surform-gallery';</script>
