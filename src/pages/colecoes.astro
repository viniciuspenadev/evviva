---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { collections } from '../data/content';
---
<Layout title="Coleções e sistemas — Evviva" description="Conheça as dez coleções Evviva e explore suas fotografias no portfólio: do mobiliário personalizado às relações entre matéria, arquitetura e design.">
  <section class="page-heading container"><p class="eyebrow">O desenho das possibilidades</p><h1>Um repertório.<br /><em>O seu olhar.</em></h1><p>Coleções e sistemas que ampliam o diálogo entre mobiliário, arquitetura e expressão pessoal.</p></section>
  <section class="collection-editorial"><div class="container collection-editorial-grid"><div class="collection-editorial-image"><Image src={collections[0].image} widths={[640, 960, 1200]} sizes="(max-width: 800px) 100vw, 45vw" format="webp" alt="Coleção Stima, acervo oficial Evviva." loading="eager" /></div><div class="collection-editorial-items">{collections.map((item, index) => <article id={item.id} class="collection-article"><p class="eyebrow">{String(index + 1).padStart(2, '0')} / {item.label}</p><h2>{item.name}</h2><p>{item.description}</p><a class="text-link" href={`/portfolio/#colecao-${item.id}`}>Ver coleção no portfólio <Arrow /></a></article>)}</div></div></section>
  <section class="section related-section"><div class="container small-editorial"><p class="eyebrow">Escolher também é descobrir</p><h2>Encontre as relações<br />que fazem sentido para você.</h2><p>A escolha de uma coleção faz parte de uma conversa maior: o espaço, a arquitetura, os materiais e o seu modo de viver.</p><a class="text-link" href="/materiais/">Explore matéria e detalhe <Arrow /></a></div></section>
</Layout>
