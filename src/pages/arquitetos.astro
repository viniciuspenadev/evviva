---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { surfaceImages } from '../data/surform-media';
import { contactHref } from '../data/site';
---
<Layout title="Para arquitetos e designers — SURFORM" description="Uma conversa sobre superfícies sólidas, especificação, desenho de bancadas e encontros com a arquitetura.">
  <section class="container ssm-page-heading"><p class="eyebrow">Para arquitetos e designers</p><h1>Seu traço.<br /><em>Novas possibilidades.</em></h1><p>Da intenção do projeto ao desenho da cuba. Um espaço para conversar sobre matéria, proporções e condições de execução.</p></section>
  <Image class="ssm-wide-image" src={surfaceImages.detail} widths={[640,960,1200,1536]} sizes="100vw" format="webp" quality={92} alt="Detalhe de borda e cuba em superfície sólida clara sobre uma base de madeira." loading="eager" />
  <section class="section ssm-approach"><div class="container"><div class="section-heading"><h2>Uma conversa que começa<br /><em>pelo seu projeto.</em></h2></div><ol class="ssm-steps"><li><span>Compartilhar</span><h3>A intenção do espaço.</h3><p>Planta, referências, medidas e a rotina prevista para o ambiente.</p></li><li><span>Estudar</span><h3>Os encontros.</h3><p>Cubas, bordas, apoios, recortes e interfaces com marcenaria e instalações.</p></li><li><span>Especificar</span><h3>As escolhas.</h3><p>Produto, acabamento e orientações técnicas compatíveis com a aplicação.</p></li></ol><a class="text-link" style="margin-top:35px" href={contactHref} target="_blank" rel="noopener noreferrer">Conversar sobre uma especificação <Arrow /></a></div></section>
</Layout>
