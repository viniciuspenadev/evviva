---
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/playfair-display/latin-400.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import '../styles/global.css';
import '../styles/surform.css';
import SurformHeader from '../components/SurformHeader.astro';
import SurformFooter from '../components/SurformFooter.astro';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { surfaceImages, surfaceImageAlts } from '../data/surform-media';
interface Props { title?: string; description?: string; invitation?: boolean; }
const { title = site.title, description = site.description, invitation = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.productionUrl).href;
const shareImage = await getImage({ src: surfaceImages.sharing, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 88 });
const shareImageUrl = new URL(shareImage.src, site.productionUrl).href;
const shareImageAlt = `${surfaceImageAlts.kitchen} Marca SURFORM à esquerda.`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#242426" />
    <meta name="robots" content={site.preview ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="SURFORM" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    {shareImageUrl.startsWith('https://') && <meta property="og:image:secure_url" content={shareImageUrl} />}
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <link rel="icon" type="image/svg+xml" href="/brand/surform-favicon.svg" />
  </head>
  <body><a class="skip-link" href="#conteudo">Pular para o conteúdo</a><SurformHeader /><main id="conteudo"><slot /></main><SurformFooter invitation={invitation} /></body>
</html>
<script>import '../scripts/smooth-scroll';</script>
