---
import Arrow from './Arrow.astro';
import EvvivaLogo from './EvvivaLogo.astro';
import { navigation } from '../data/site';
const currentPath = Astro.url.pathname;
---
<header class="site-header" id="site-header">
  <div class="header-inner">
    <EvvivaLogo />
    <nav class="desktop-nav" aria-label="Navegação principal">
      {navigation.map(item => <a href={item.href} aria-current={item.href === currentPath ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <button class="button button-dark header-appointment" type="button" data-open-contact>Agendar uma conversa <Arrow /></button>
    <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu" data-open-menu><span></span><span></span></button>
  </div>
</header>
<dialog class="mobile-menu" id="mobile-menu" aria-label="Menu de navegação">
  <div class="menu-top"><EvvivaLogo /><button type="button" class="icon-button close-button" aria-label="Fechar menu" data-close-menu>×</button></div>
  <nav aria-label="Navegação no celular">{navigation.map((item, index) => <a href={item.href}><span class="eyebrow">0{index + 1}</span>{item.label}<Arrow /></a>)}</nav>
  <div class="menu-bottom"><p>Uma casa que faz sentido para você.</p><button class="button button-dark" type="button" data-open-contact>Agendar uma conversa <Arrow /></button></div>
</dialog>
<script>
  const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const trigger = document.querySelector<HTMLButtonElement>('[data-open-menu]');
  const close = () => menu?.close();
  trigger?.addEventListener('click', () => { menu?.showModal(); trigger.setAttribute('aria-expanded', 'true'); document.body.classList.add('dialog-open'); });
  menu?.querySelector('[data-close-menu]')?.addEventListener('click', close);
  menu?.querySelectorAll('a, [data-open-contact]').forEach(link => link.addEventListener('click', close));
  menu?.addEventListener('close', () => { trigger?.setAttribute('aria-expanded', 'false'); if (!document.querySelector('dialog[open]')) document.body.classList.remove('dialog-open'); });
</script>
