---
import Arrow from './Arrow.astro';
import { contactHref, contactLabel } from '../data/site';
interface Props { professional?: boolean; }
const { professional = false } = Astro.props;
const topics = professional ? [
  { title: 'Planta, cotas e cortes', text: 'Planta do ambiente, medidas da bancada e cortes que mostrem alturas, apoios e encontros. Indique a posição das cubas e os trechos que precisam de atenção.' },
  { title: 'Equipamentos e instalações', text: 'Modelos e dimensões de equipamentos, torneiras e válvulas; pontos hidráulicos, elétricos e passagens previstas. Essas informações orientam os recortes e a montagem.' },
  { title: 'Uso, produto e cuidados', text: 'Atividade do ambiente, frequência de uso e rotina de limpeza. Em clínicas e espaços comerciais, compartilhe os requisitos definidos pelo responsável técnico para avaliar o produto e o desenho.' },
] : [
  { title: 'O ambiente e a sua ideia', text: 'Conte onde a superfície será usada: cozinha, lavabo, banho, área gourmet, lavanderia, espaço comercial ou clínica. Fotos do local e referências ajudam a entender o que você procura.' },
  { title: 'Medidas e pontos de uso', text: 'Compartilhe a planta ou as medidas aproximadas disponíveis, a posição da água e do esgoto e os equipamentos previstos. As medidas finais e os encontros são validados para o projeto.' },
  { title: 'O momento do projeto', text: 'Informe se está na fase de referências, com o desenho em andamento ou com a obra em execução. Se houver arquiteto ou designer acompanhando, a conversa pode ser feita em conjunto.' },
];
---
<section class="ssm-preparation section" id="preparar" aria-labelledby="preparation-heading"><div class="container ssm-preparation-grid"><div><p class="eyebrow">Para uma conversa mais completa</p><h2 id="preparation-heading">Boas referências.<br /><em>Um bom começo.</em></h2><p class="ssm-preparation-intro">{professional ? 'Informações que ajudam a transformar a intenção do projeto em um desenho de superfície.' : 'Reúna o que já tem sobre o espaço. Cada referência ajuda a dar direção às primeiras escolhas.'}</p><a class="text-link" href={contactHref} target="_blank" rel="noopener noreferrer">{contactLabel}<Arrow /></a></div><div class="ssm-preparation-topics">{topics.map((topic,index) => <details open={index === 0}><summary>{topic.title}<span aria-hidden="true">+</span></summary><p>{topic.text}</p></details>)}</div></div></section>
