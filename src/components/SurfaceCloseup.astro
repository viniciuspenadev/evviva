---
import { Image } from 'astro:assets';
import graphiteSink from '../assets/surform/detalhe-grafite-agua-popout-2026-11-04.png';
---
<div class="surface-closeup">
  <Image
    src={graphiteSink}
    widths={[480, 800, 1200, graphiteSink.width]}
    sizes="(max-width: 800px) 110vw, (min-width: 1680px) 860px, 52vw"
    format="webp"
    quality={92}
    alt="Detalhe de bancada e cuba integrada em superfície sólida grafite, com torneira cromada ultrapassando a moldura arredondada e um fio de água caindo em direção ao ralo."
    loading="lazy"
  />
</div>
<style>
  /* Recorta só a folga transparente lateral; a torneira permanece inteira. */
  .surface-closeup { min-width: 0; aspect-ratio: 1224 / 1086; overflow: clip; }
  .surface-closeup img { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
