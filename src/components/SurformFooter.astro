---
import ContactBand from './ContactBand.astro';
import { site, navigation } from '../data/site';
interface Props { invitation?: boolean; }
const { invitation = true } = Astro.props;
---
{invitation && <ContactBand />}
<footer class="ssm-footer"><div class="container"><div class="ssm-footer-top"><a class="surform-brand" href="/" aria-label="SURFORM — início"><span>SURFORM</span><small>Superfícies sólidas</small></a><p>Matéria. Desenho.<br />O seu jeito de viver.</p><nav aria-label="Navegação do rodapé">{navigation.map(item => <a href={item.href}>{item.label}</a>)}<a href="/arquitetos/">Para arquitetos</a><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a></nav></div><div class="ssm-footer-bottom"><span>SURFORM © 2026</span><div><a href="/privacidade/">Privacidade</a><a href="/privacidade/#imagens">Sobre as imagens</a><a href={site.evvivaUrl} target="_blank" rel="noopener noreferrer">Conheça a Evviva ↗</a></div></div></div></footer>
