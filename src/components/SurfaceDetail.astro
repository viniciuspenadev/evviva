---
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import detailWorkstation from '../assets/surform/detalhe-cuba-escorredor-2026-11.png';
import '../styles/surface-study.css';
const details = [
  { label: 'Cuba', title: 'Cuba integrada.', text: 'Cantos suaves e integração com a bancada. Profundidade e proporções acompanham o uso do espaço.', x: 37, y: 57, mobileX: 24, mobileY: 65 },
  { label: 'Escorredor', title: 'Apoio que se encaixa.', text: 'Peça removível apoiada no rebaixo da cuba. Recortes e apoios são definidos no desenho técnico.', x: 75, y: 48, mobileX: 80, mobileY: 60 },
  { label: 'Borda', title: 'O encontro da borda.', text: 'Espessura, acabamento e encontros com a base são pensados junto com o desenho da bancada.', x: 61, y: 85, mobileX: 61, mobileY: 87 },
];
---
<section class="surface-study" id="superficies" aria-labelledby="material-heading" data-surface-study>
  <div class="container">
    <div class="surface-study-heading">
      <div><p class="eyebrow">A matéria por trás da forma</p><h2 id="material-heading">O detalhe faz<br /><em>parte do todo.</em></h2></div>
      <div class="surface-study-intro"><p>Superfície sólida mineral.<br />Bancada, cuba e acessórios em um mesmo desenho.</p><a class="text-link" href="/superficies/">Conheça a superfície sólida <Arrow /></a></div>
    </div>
  </div>
    <div class="surface-study-stage" data-detail-stage>
      <div class="surface-study-visual" data-detail-photo>
        <Image src={detailWorkstation} widths={[640,960,1280,detailWorkstation.width]} sizes="(max-width:700px) 1000px, 100vw" format="webp" quality={94} alt="Bancada e cuba integradas em superfície sólida acetinada, com rebaixo de apoio e escorredor removível com recortes e perfurações." loading="lazy" />
        <span class="surface-study-photo-label">Superfície sólida / Acabamento acetinado</span>
        {details.map((detail,index) => <button class="surface-study-pin" type="button" style={`--detail-x:${detail.x}%;--detail-y:${detail.y}%;--detail-mobile-x:${detail.mobileX}%;--detail-mobile-y:${detail.mobileY}%`} aria-label={`Explorar detalhe: ${detail.label}`} aria-expanded="false" aria-controls={`surface-detail-${index}`} data-detail-trigger={index}><span>{String(index+1).padStart(2,'0')}</span><span class="surface-study-pin-label" aria-hidden="true">{detail.label}</span></button>)}
      </div>
      <aside class="surface-study-popover" aria-label="Informações do detalhe selecionado" data-detail-popover hidden>
        <div class="surface-study-info-top"><span class="surface-study-anchor" aria-hidden="true" data-detail-anchor></span><p>Um olhar de perto</p><span class="surface-study-counter" data-detail-counter>01 / 03</span><button type="button" aria-label="Fechar detalhe" class="surface-study-close" data-detail-close>×</button></div>
        <div class="surface-study-panels" aria-live="polite" aria-atomic="false">
          {details.map((detail,index) => <article class="surface-study-panel" id={`surface-detail-${index}`} aria-labelledby={`surface-detail-title-${index}`} data-detail-panel={index} hidden><h3 id={`surface-detail-title-${index}`}>{detail.title}</h3><p>{detail.text}</p></article>)}
        </div>
      </aside>
      <svg class="surface-study-lines" aria-hidden="true">{details.map((_,index) => <g class="surface-study-line" data-detail-line={index}><path pathLength="1" /><circle r="3" /></g>)}</svg>
    </div>
</section>
<script>import '../scripts/surface-study';</script>
