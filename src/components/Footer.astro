---
import Arrow from './Arrow.astro';
import EvvivaLogo from './EvvivaLogo.astro';
import { site } from '../data/site';
interface Props { invitation?: boolean; }
const { invitation = true } = Astro.props;
---
{invitation && <section class="invitation" aria-labelledby="invitation-title"><div class="container invitation-inner"><div><p class="eyebrow">Um próximo capítulo</p><h2 id="invitation-title">Seu projeto começa<br />com uma conversa.</h2></div><div class="invitation-actions"><button type="button" class="button button-ivory" data-open-contact>Agendar uma conversa <Arrow /></button><a class="text-link" href="/nossa-loja/">Conhecer a experiência <Arrow /></a></div></div></section>}
<footer class="site-footer">
  <div class="container footer-top"><EvvivaLogo light /><p>Design que acolhe.<br />Detalhes que revelam você.</p><nav aria-label="Navegação do rodapé"><a href="/colecoes/">Coleções</a><a href="/materiais/">Matéria e detalhe</a><a href="/surform-ssm/">SURFORM · Superfícies em SSM</a><a href="/arquitetos/">Para arquitetos</a><a href={site.storeLocator} target="_blank" rel="noopener noreferrer">Encontrar uma loja ↗</a></nav></div>
  <div class="container footer-bottom"><span>Evviva · Mobiliário personalizado.</span><div><a href="/privacidade/">Privacidade</a><a href={site.officialUrl} target="_blank" rel="noopener noreferrer">Universo Evviva ↗</a></div></div>
</footer>
