---
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import { images } from '../data/images';
import { services } from '../data/services';
---
<section class="service-categories" id="projetos" aria-labelledby="services-title">
  <div class="container">
    <div class="services-heading"><div><p class="eyebrow">Nossos serviços</p><h2 id="services-title">SSM, planejados<br /><em>e móveis.</em></h2></div><p>Três especialidades para<br />{' '}compor o seu espaço.</p></div>
    <ul class="services-grid" aria-label="Categorias de serviços">{services.map((service, index) => <li><a class="service-card" href={service.href} aria-label={service.action}>
      <Image src={images[service.image]} widths={[320, 480, 720]} sizes="(max-width: 1000px) 90vw, 30vw" format="webp" quality={85} alt={service.alt} style={`object-position:${service.position}`} loading="lazy" />
      <div class="service-card-shade"></div><div class="service-card-top"><span>0{index + 1} / {service.label}</span></div>
      <div class="service-card-copy"><h3>{service.title}</h3><p>{service.description}</p><span class="service-card-action">{service.action}<Arrow /></span></div>
    </a></li>)}</ul>
  </div>
</section>
<style>
  .service-categories { background: var(--ivory); padding-top: 80px; }
  .services-heading { display: flex; align-items: end; justify-content: space-between; gap: 40px; margin-bottom: 36px; }
  .services-heading h2 { font-size: clamp(42px, 4.4vw, 68px); line-height: 1.1; }
  .services-heading > p { font-size: 14px; line-height: 1.7; color: var(--muted); padding-bottom: 6px; }
  .services-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; padding: 0; list-style: none; margin: 0; }
  .services-grid > li { min-width: 0; }
  .service-card { position: relative; isolation: isolate; display: block; overflow: hidden; height: clamp(450px, 36vw, 560px); border-radius: 18px; background: var(--olive); color: var(--paper); }
  .service-card > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -3; transition: transform .9s cubic-bezier(.2,.65,.3,1); }
  .service-card:hover > img, .service-card:focus-visible > img { transform: scale(1.045); }
  .service-card-shade { position: absolute; inset: 0; z-index: -2; background: linear-gradient(0deg, rgb(13 15 10 / .92), rgb(13 15 10 / .25) 42%, transparent 75%), linear-gradient(180deg, rgb(13 15 10 / .28), transparent 25%); }
  .service-card-top { position: absolute; top: 22px; left: 22px; right: 22px; display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 8px; }
  .service-card-top > span:first-child { text-transform: uppercase; letter-spacing: .09em; text-shadow: 0 1px 6px #000; }
  .service-card-copy { position: absolute; bottom: 27px; left: 27px; right: 27px; }
  .service-card-copy h3 { font-size: clamp(31px, 2.6vw, 42px); line-height: 1.15; }
  .service-card-copy > p { margin-top: 13px; font-size: 12px; line-height: 1.7; color: #e1ddd3; max-width: 360px; }
  .service-card-action { display: flex; align-items: center; justify-content: space-between; gap: 25px; margin-top: 24px; padding-top: 16px; border-top: 1px solid rgb(255 255 255 / .32); font-size: 10px; }
  .service-card-action :global(.arrow-icon) { width: 21px; transform: rotate(-35deg); }
  .service-card:hover .service-card-action :global(.arrow-icon) { transform: rotate(-35deg) translateX(3px); }
  @media(max-width: 1000px) { .services-grid { grid-template-columns: 1fr; gap: 24px; } .service-card { height: 380px; } .service-card-copy h3 { font-size: 38px; } .service-card-copy > p { max-width: 420px; } }
  @media(max-width: 600px) { .service-categories { padding-top: 52px; } .services-heading { flex-direction: column; align-items: start; gap: 22px; margin-bottom: 28px; } .services-heading h2 { font-size: clamp(36px, 10vw, 46px); } .services-heading > p { font-size: 12px; padding: 0; } .services-heading > p br { display: none; } .service-card { height: 420px; border-radius: 15px; } .service-card-top { top: 18px; left: 18px; right: 18px; font-size: 7px; } .service-card-copy { left: 23px; right: 23px; bottom: 24px; } .service-card-copy h3 { font-size: 34px; } .service-card-copy > p { font-size: 11px; } }
  @media(prefers-reduced-motion: reduce) { .service-card > img { transition: none; } }
</style>
