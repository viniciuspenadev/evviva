---
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import { applications } from '../data/surform-media';
import '../styles/collections.css';
---
<section class="collection-experience ssm-applications" id="aplicacoes" aria-labelledby="applications-title" data-collection-wheel data-link-label="Explorar">
  <div class="collection-composition">
    <a class="collection-visual" href="/aplicacoes/cozinhas/" aria-label="Explorar Cozinhas" data-wheel-link><div class="collection-photos">{applications.map((item,index) => <div class:list={['collection-photo', {'is-active':index === 0}]} data-wheel-photo aria-hidden={index !== 0 ? 'true' : undefined}><Image src={item.image} widths={[640,960,1440].filter(width => width <= item.image.width)} sizes="(max-width:700px) 700px, 62vw" format="webp" quality={90} alt={item.alt} style={`object-position:${item.position}`} loading="lazy" /></div>)}<span class="collection-image-arrow" aria-hidden="true"><Arrow /></span></div></a>
    <div class="collection-selector"><div class="collection-card"><p class="eyebrow">Aplicações</p><h2 id="applications-title">Uma matéria.<br /><em>Muitas formas de viver.</em></h2><button class="collection-motion-control" type="button" aria-label="Pausar rotação automática" aria-pressed="false" data-wheel-pause>Pausar animação</button><p class="collection-keyboard-help" id="application-help">Use as setas para escolher uma aplicação e Enter para conhecer os detalhes. Espaço pausa ou retoma a animação.</p><div class="collection-orbit" role="listbox" aria-label="Selecionar aplicação" aria-describedby="application-help" data-wheel-orbit>{applications.map((item,index) => <a id={`application-${item.id}`} class="collection-option" role="option" aria-selected={index === 0 ? 'true':'false'} href={`/aplicacoes/${item.id}/`} data-wheel-option data-name={item.name}>{item.name}</a>)}</div></div></div>
  </div>
</section>
<script>import '../scripts/collections';</script>
